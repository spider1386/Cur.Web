@model CartaViewModel
@{
    ViewData["Title"] = "Carta de presentación";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-envelope-paper me-2 text-primary"></i>Carta de presentación</h1>
        <p class="text-muted mb-0">
            Arma un borrador con los logros que ya registraste y ajústalo a tu voz.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Estilo">
            <i class="bi @Model.InfoTono.Icono me-1"></i>Estilo: @Model.InfoTono.Nombre
        </a>
        <a class="btn btn-outline-secondary" asp-controller="Curriculum" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i>Volver al panel
        </a>
    </div>
</div>

@if (!Model.TonoDefinido)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <i class="bi bi-info-circle"></i>
        <span class="flex-grow-1">
            Todavía no has definido cómo quieres sonar. Son ocho afirmaciones y toma un minuto.
        </span>
        <a class="btn btn-sm btn-primary" asp-action="Estilo">Definir mi estilo</a>
    </div>
}

@if (!Model.HayEvidencia)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
        <i class="bi bi-exclamation-triangle"></i>
        <span class="flex-grow-1">
            Aún no tienes logros ni competencias registrados. Una carta sin evidencia se queda
            en adjetivos: agrégalos en tu experiencia y vuelve.
        </span>
        <a class="btn btn-sm btn-outline-dark" asp-controller="Curriculum" asp-action="Index">Ir al panel</a>
    </div>
}

<form method="post" asp-action="Generar">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="cv-card mb-4">
                <div class="p-3 p-md-4">
                    <h2 class="h6 fw-semibold mb-3">
                        <i class="bi bi-bullseye me-2 text-primary"></i>A qué te postulas
                    </h2>

                    <div class="mb-3">
                        <label asp-for="CargoObjetivo" class="form-label"></label>
                        <input asp-for="CargoObjetivo" class="form-control" placeholder="Analista de datos" />
                        <span asp-validation-for="CargoObjetivo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Empresa" class="form-label"></label>
                        <input asp-for="Empresa" class="form-control" placeholder="Opcional" />
                        <span asp-validation-for="Empresa" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Motivacion" class="form-label"></label>
                        <textarea asp-for="Motivacion" class="form-control" rows="3"
                                  placeholder="Opcional. Una o dos frases, con tus palabras."></textarea>
                        <span asp-validation-for="Motivacion" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            @if (Model.Logros.Count > 0)
            {
                <div class="cv-card mb-4">
                    <div class="p-3 p-md-4">
                        <h2 class="h6 fw-semibold mb-1">
                            <i class="bi bi-trophy me-2 text-primary"></i>Logros que quieres destacar
                        </h2>
                        <p class="text-muted small mb-3">Elige dos o tres. Más de eso diluye la carta.</p>

                        <div class="d-grid gap-2">
                            @foreach (var logro in Model.Logros)
                            {
                                var marcado = Model.LogrosIds.Contains(logro.Id);
                                <label class="cv-plantilla @(marcado ? "cv-plantilla-activa" : "")">
                                    <input class="form-check-input mt-1" type="checkbox"
                                           name="LogrosIds" value="@logro.Id" checked="@marcado" />
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">@logro.Titulo</div>
                                        <p class="text-muted small mb-1">@logro.Descripcion</p>
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-briefcase me-1"></i>@logro.Origen
                                        </p>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (Model.Competencias.Count > 0)
            {
                <div class="cv-card mb-4">
                    <div class="p-3 p-md-4">
                        <h2 class="h6 fw-semibold mb-1">
                            <i class="bi bi-lightbulb me-2 text-primary"></i>Competencias que quieres destacar
                        </h2>
                        <p class="text-muted small mb-3">Con el nivel que ya declaraste en tu experiencia.</p>

                        <div class="d-grid gap-2">
                            @foreach (var competencia in Model.Competencias)
                            {
                                var marcado = Model.CompetenciasIds.Contains(competencia.Id);
                                <label class="cv-plantilla @(marcado ? "cv-plantilla-activa" : "")">
                                    <input class="form-check-input mt-1" type="checkbox"
                                           name="CompetenciasIds" value="@competencia.Id" checked="@marcado" />
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">@competencia.Descripcion</div>
                                        <p class="text-muted small mb-0">
                                            Nivel: @competencia.Nivel
                                            <span class="ms-1"><i class="bi bi-briefcase me-1"></i>@competencia.Origen</span>
                                        </p>
                                    </div>
                                </label>
                            }
                        </div>
                    </div>
                </div>
            }

            <button type="submit" asp-action="Generar" class="btn btn-primary w-100">
                <i class="bi bi-stars me-1"></i>Generar borrador
            </button>
            <p class="text-muted small mt-2 mb-0">
                Se redacta en tono <strong>@Model.InfoTono.Nombre.ToLowerInvariant()</strong>.
                Generar no guarda nada: reemplaza el texto de la derecha.
            </p>
        </div>

        <div class="col-lg-7">
            <div class="cv-card">
                <div class="p-3 p-md-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="h6 fw-semibold mb-0">
                            <i class="bi bi-pencil-square me-2 text-primary"></i>Tu carta
                        </h2>
                        @if (Model.TieneCartaGuardada)
                        {
                            <span class="badge text-bg-success">Guardada</span>
                        }
                    </div>

                    <textarea asp-for="Texto" class="form-control" rows="20"
                              placeholder="Genera un borrador con el botón de la izquierda, o escribe la carta desde cero."></textarea>
                    <span asp-validation-for="Texto" class="text-danger small"></span>

                    <div class="form-check mt-3">
                        <input asp-for="IncluirEnHojaDeVida" class="form-check-input" />
                        <label asp-for="IncluirEnHojaDeVida" class="form-check-label"></label>
                        <p class="text-muted small mb-0">
                            La carta se antepone como primera página al descargar en PDF y en HTML.
                        </p>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <button type="submit" asp-action="Guardar" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i>Guardar carta
                        </button>
                    </div>

                    <p class="text-muted small mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        El borrador es un punto de partida armado con tus propios datos. La carta la
                        firmas tú: léela completa y déjala con tus palabras antes de enviarla.
                    </p>
                </div>
            </div>
        </div>
    </div>
</form>

@if (Model.TieneCartaGuardada)
{
    <form method="post" asp-action="Eliminar" class="mt-3">
        <button type="submit" class="btn btn-sm btn-outline-danger">
            <i class="bi bi-trash me-1"></i>Eliminar mi carta
        </button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
