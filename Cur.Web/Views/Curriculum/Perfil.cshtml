@model PerfilViewModel
@{
    ViewData["Title"] = "Datos personales";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Datos personales</h1>
    <a class="btn btn-sm btn-outline-secondary" asp-action="Index">Volver al panel</a>
</div>

<div class="cv-card">
    <form asp-action="Perfil" method="post" enctype="multipart/form-data" novalidate>
        <div class="p-3 p-md-4">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <input type="hidden" asp-for="BasicaId" />
            <input type="hidden" asp-for="UrlImagen" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Foto" class="form-label"></label>
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(Model.UrlImagen) && Model.UrlImagen.StartsWith('/'))
                        {
                            <img class="cv-foto" src="@Model.UrlImagen" alt="Foto actual" />
                        }
                        <div class="flex-grow-1">
                            <input asp-for="Foto" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <div class="form-text">JPG, PNG o WEBP. Máximo 2 MB.</div>
                            <span asp-validation-for="Foto" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <label asp-for="Nombres" class="form-label"></label>
                    <input asp-for="Nombres" class="form-control" />
                    <span asp-validation-for="Nombres" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Apellidos" class="form-label required"></label>
                    <input asp-for="Apellidos" class="form-control" />
                    <span asp-validation-for="Apellidos" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Documento" class="form-label required"></label>
                    <input asp-for="Documento" class="form-control" inputmode="numeric" />
                    <span asp-validation-for="Documento" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Email" class="form-label required"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ProfesionId" class="form-label required"></label>
                    <select asp-for="ProfesionId" asp-items="Model.Profesiones" class="form-select">
                        <option value="">Selecciona…</option>
                    </select>
                    <span asp-validation-for="ProfesionId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TelefonoMovil" class="form-label required"></label>
                    <input asp-for="TelefonoMovil" class="form-control" />
                    <span asp-validation-for="TelefonoMovil" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TelefonoFijo" class="form-label required"></label>
                    <input asp-for="TelefonoFijo" class="form-control" />
                    <span asp-validation-for="TelefonoFijo" class="text-danger small"></span>
                </div>

                <div class="col-md-4"></div>

                <div class="col-md-6">
                    <label asp-for="DepartamentoId" class="form-label required"></label>
                    <select asp-for="DepartamentoId" asp-items="Model.Departamentos" class="form-select" id="departamento">
                        <option value="">Selecciona…</option>
                    </select>
                    <span asp-validation-for="DepartamentoId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CiudadId" class="form-label required"></label>
                    <select asp-for="CiudadId" asp-items="Model.Ciudades" class="form-select" id="ciudad"
                            data-url="@Url.Action("Municipios", "Curriculum")">
                        <option value="">Selecciona…</option>
                    </select>
                    <span asp-validation-for="CiudadId" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="PerfilProfesional" class="form-label required"></label>
                    <textarea asp-for="PerfilProfesional" class="form-control" rows="5"
                              placeholder="Resume en pocas líneas quién eres profesionalmente, tu experiencia y hacia dónde vas."></textarea>
                    <span asp-validation-for="PerfilProfesional" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="cv-card-header justify-content-end border-top border-bottom-0">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            <button type="submit" class="btn btn-primary">Guardar datos</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const departamento = document.getElementById('departamento');
            const ciudad = document.getElementById('ciudad');
            if (!departamento || !ciudad) return;

            departamento.addEventListener('change', async function () {
                ciudad.innerHTML = '<option value="">Cargando…</option>';

                if (!this.value) {
                    ciudad.innerHTML = '<option value="">Selecciona…</option>';
                    return;
                }

                try {
                    const respuesta = await fetch(`${ciudad.dataset.url}?departamentoId=${encodeURIComponent(this.value)}`);
                    const municipios = await respuesta.json();

                    ciudad.innerHTML = '<option value="">Selecciona…</option>';
                    for (const m of municipios) {
                        const opcion = document.createElement('option');
                        opcion.value = m.value;
                        opcion.textContent = m.text;
                        ciudad.appendChild(opcion);
                    }
                } catch {
                    ciudad.innerHTML = '<option value="">No se pudieron cargar las ciudades</option>';
                }
            });
        })();
    </script>
}
