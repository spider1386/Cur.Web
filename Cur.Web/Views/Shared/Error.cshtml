@model ErrorViewModel
@{
    ViewData["Title"] = "Algo salió mal";
}

<div class="cv-auth-card text-center">
    <h1>Algo salió mal</h1>
    <p class="text-muted mb-4">Ocurrió un error al procesar tu solicitud. Intenta de nuevo en un momento.</p>

    @if (Model?.ShowRequestId ?? false)
    {
        <p class="text-muted small">
            Código de la solicitud: <code>@Model!.RequestId</code>
        </p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
