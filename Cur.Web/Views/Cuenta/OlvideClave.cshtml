@model OlvideClaveViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="cv-auth-card">
    <h1>Recupera tu acceso</h1>
    <p class="text-muted mb-4">Te enviamos un enlace para crear una contraseña nueva.</p>

    <form asp-action="OlvideClave" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label required"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Enviar enlace</button>
    </form>

    <p class="text-center text-muted small mt-4 mb-0">
        <a asp-action="Login">Volver a iniciar sesión</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
