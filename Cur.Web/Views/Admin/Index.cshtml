@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Administración";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1"><i class="bi bi-shield-lock me-2 text-primary"></i>Panel de administración</h1>
        <p class="text-muted mb-0">Estado general de la plataforma y accesos de gestión.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Usuarios"><i class="bi bi-people me-1"></i>Usuarios</a>
        <a class="btn btn-primary" asp-action="Parametros"><i class="bi bi-sliders me-1"></i>Parámetros</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="cv-kpi">
            <i class="bi bi-people cv-kpi-icono"></i>
            <span class="cv-kpi-valor">@Model.TotalUsuarios</span>
            <span class="cv-kpi-etiqueta">Usuarios registrados</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="cv-kpi">
            <i class="bi bi-file-person cv-kpi-icono"></i>
            <span class="cv-kpi-valor">@Model.UsuariosConHojaVida</span>
            <span class="cv-kpi-etiqueta">Con hoja de vida</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="cv-kpi">
            <i class="bi bi-lock cv-kpi-icono"></i>
            <span class="cv-kpi-valor">@Model.UsuariosBloqueados</span>
            <span class="cv-kpi-etiqueta">Cuentas bloqueadas</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="cv-kpi">
            <i class="bi bi-envelope-exclamation cv-kpi-icono"></i>
            <span class="cv-kpi-valor">@Model.UsuariosSinConfirmar</span>
            <span class="cv-kpi-etiqueta">Correos sin confirmar</span>
        </div>
    </div>
</div>

<div class="accordion cv-acordeon" id="acordeonAdmin">

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#admContenido">
                <i class="bi bi-bar-chart-line me-2"></i>Contenido cargado
            </button>
        </h2>
        <div id="admContenido" class="accordion-collapse collapse show" data-bs-parent="#acordeonAdmin">
            <div class="accordion-body">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="cv-mini">
                            <i class="bi bi-briefcase text-primary"></i>
                            <div><strong>@Model.TotalExperiencias</strong><span>Experiencias</span></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="cv-mini">
                            <i class="bi bi-mortarboard text-primary"></i>
                            <div><strong>@Model.TotalFormaciones</strong><span>Formaciones</span></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="cv-mini">
                            <i class="bi bi-trophy text-primary"></i>
                            <div><strong>@Model.TotalLogros</strong><span>Logros</span></div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="cv-mini">
                            <i class="bi bi-lightbulb text-primary"></i>
                            <div><strong>@Model.TotalCompetencias</strong><span>Competencias</span></div>
                        </div>
                    </div>
                </div>

                @if (Model.UsuariosSinHojaVida > 0 || Model.HojasVidaSinDuenio > 0)
                {
                    <ul class="list-unstyled small text-muted mt-3 mb-0">
                        @if (Model.UsuariosSinHojaVida > 0)
                        {
                            <li><i class="bi bi-exclamation-circle me-1"></i>@Model.UsuariosSinHojaVida usuario(s) todavía no han iniciado su hoja de vida.</li>
                        }
                        @if (Model.HojasVidaSinDuenio > 0)
                        {
                            <li><i class="bi bi-link-45deg me-1"></i>@Model.HojasVidaSinDuenio hoja(s) de vida heredadas sin usuario asociado.</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#admParametros">
                <i class="bi bi-sliders me-2"></i>Catálogo de parámetros
                <span class="badge text-bg-secondary ms-2">@Model.TotalParametros</span>
            </button>
        </h2>
        <div id="admParametros" class="accordion-collapse collapse" data-bs-parent="#acordeonAdmin">
            <div class="accordion-body">
                <p class="text-muted small">
                    La tabla <code>Parametros</code> alimenta todas las listas desplegables de la aplicación.
                    Cada grupo corresponde a un valor de la columna <code>Cdgo</code>.
                </p>
                <div class="row g-2">
                    @foreach (var grupo in Model.Grupos)
                    {
                        <div class="col-md-6 col-lg-4">
                            <a class="cv-grupo" asp-action="Parametros" asp-route-grupo="@grupo.Codigo">
                                <i class="bi @grupo.Icono"></i>
                                <span class="flex-grow-1">@grupo.Nombre</span>
                                <span class="badge text-bg-light">@grupo.Cantidad</span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>
